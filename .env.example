GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_QUICK_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=50
ESP32_CAMERA_URL=http://192.168.1.50/capture
PADDLEOCR_LANG=hi
YOLO_MODEL=yolo26n.pt
GOOGLE_MAPS_API_KEY=your_google_maps_routes_api_key_here
GOOGLE_MAPS_REGION_CODE=IN
NAVIS_SPEECH_LOCALE=en-IN

# API Authentication Token for remote detection and client security
API_TOKEN=your_secure_random_api_token_here

# VL53L0X Distance Sensor Configuration
DISTANCE_SENSOR_MODE=auto
DISTANCE_SENSOR_MODEL=VL53L0X
SENSOR_MIN_RANGE_M=0.03
SENSOR_MAX_RANGE_M=2.0
DISTANCE_WARN_THRESHOLD_M=1.2
SENSOR_MAX_AGE_MS=1000
